# Copy to .env.local for local development. Set real values in your hosting provider's
# environment settings, never in Git.

# Supabase project URL and publishable (anon) key. Both are public by design: RLS and
# database function grants enforce access. No service-role/secret key is used by this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
